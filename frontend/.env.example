# Copie este arquivo para ".env" e ajuste se necessário. Os valores abaixo já
# são os padrões de um `hardhat node` e de um `ipfs daemon` locais.

# RPC usada pela consulta PÚBLICA (sem MetaMask) em cada rede.
VITE_RPC_URL_LOCALHOST=http://127.0.0.1:8545
VITE_RPC_URL_SEPOLIA=https://sepolia.infura.io/v3/SEU_PROJECT_ID

# API HTTP e gateway do nó Kubo local, usados para enviar e recuperar os
# metadados das garrafas e das etapas produtivas.
VITE_KUBO_API_URL=http://127.0.0.1:5001
VITE_KUBO_GATEWAY_URL=http://127.0.0.1:8080
