# Copie este arquivo para ".env" e ajuste se necessário. Os valores abaixo já
# são os padrões de um `hardhat node` local.

# RPC usada pela consulta PÚBLICA (sem MetaMask) em cada rede.
# Use um endpoint público (ex: https://rpc.sepolia.org) ou um endpoint pago
# com chave própria (Infura, Alchemy) para evitar erros de rate limit.
VITE_RPC_URL_LOCALHOST=http://127.0.0.1:8545
VITE_RPC_URL_SEPOLIA=https://rpc.sepolia.org

# URL base pública da aplicação (usada pelo QR Code).
# Em dev, deixe vazio — o sistema usa window.location.origin automaticamente.
# Em produção (Vercel), defina como a URL real do deploy.
VITE_PUBLIC_APP_URL=https://destiloc.vercel.app

# URL do backend Destiloc (o JWT do Pinata fica somente em backend/.env).
VITE_API_URL=http://localhost:3001
