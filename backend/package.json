{
  "name": "destiloc-api",
  "version": "0.1.0",
  "private": true,
  "description": "API backend do protótipo de rastreabilidade de bebidas destiladas (TCC)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:schema": "psql $DATABASE_URL -f src/db/schema.sql",
    "db:migrate": "tsx src/db/migrar.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^10.2.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "ethers": "^6.17.0",
    "fastify": "^5.3.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
