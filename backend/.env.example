# Porta e host do servidor HTTP (padrão: 3001 / 0.0.0.0)
PORT=3001
HOST=0.0.0.0

# String de conexão PostgreSQL.
# Em produção, use a URL do Neon com ?sslmode=require.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/destiloc

# JWT do Pinata — gere em https://app.pinata.cloud/developers/api-keys
# Nunca versione o valor real; este arquivo é apenas o modelo.
PINATA_JWT=SEU_JWT_AQUI

# Origem permitida pelo CORS.
# Em produção, use a URL pública do frontend (ex.: https://destiloc.vercel.app).
CORS_ORIGIN=http://localhost:5173

# Ambiente de execução: development | production
NODE_ENV=development

# Secret para assinar JWT (mínimo 32 caracteres).
JWT_SECRET=troque-por-um-valor-secreto-e-longo-aqui

# Endereços Ethereum do administrador inicial (separados por vírgula).
# A carteira ainda precisa comprovar posse via assinatura de challenge.
ADMIN_WALLET=0xSeuEnderecoAqui

# URLs RPC para consulta à blockchain (somente leitura, nunca expostas ao cliente).
# Recomendado: Alchemy (free tier maior — https://alchemy.com).
# Hardhat local usa 127.0.0.1:8545 por padrão; só defina se precisar de outra porta.
RPC_URL_SEPOLIA=https://eth-sepolia.g.alchemy.com/v2/SUA_KEY_AQUI
RPC_URL_LOCALHOST=http://127.0.0.1:8545
